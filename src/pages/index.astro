---
import "../styles/global.css";
import "../styles/game.css";
import GameMenu from "../components/GameMenu.tsx";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta
			name="description"
			content="CesarFolio — portafolio interactivo de César Domínguez, desarrollador Full Stack & DevOps. Un menú de videojuego sin scroll."
		/>
		<meta name="theme-color" content="#05070a" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Orbitron:wght@500;700;900&family=Pirata+One&family=Special+Elite&family=Teko:wght@400;500;600;700&family=Zen+Maru+Gothic:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>CesarFolio — Menú Principal</title>
	</head>
	<body>
		<GameMenu client:load />
	</body>
</html>
